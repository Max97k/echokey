    <!-- Settings & Disclosure -->
    <string name="disclosure_title">Voice &amp; Data Disclosure</string>
    <string name="disclosure_body">AKeyboard is a voice-only keyboard. Audio is captured only while you hold the microphone button and is streamed directly to Google Gemini API using your own API key.\n\nAKeyboard does not save audio to disk and has no developer backend server. Google processes the audio under your Google AI Studio account terms.</string>
    <string name="disclosure_setup_hint">Using AKeyboard requires your own Google AI Studio API key (free tier available in eligible regions; see the next screen for setup steps). Data handling depends on the Google AI Studio plan you choose (free or paid) under Google\'s Gemini API terms.</string>
    <string name="disclosure_agree">Agree and Continue</string>

